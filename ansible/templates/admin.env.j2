# AJS Suite Environment Configuration
# Rendered by Ansible during deployment.
# app_base_url and other vars are passed from ansible/site.yml vars.

APP_ENV=production
APP_BASE_URL={{ app_base_url }}
SECRET_KEY={{ secret_key }}
GOOGLE_CLIENT_ID={{ google_client_id }}
GOOGLE_CLIENT_SECRET={{ google_client_secret }}
ADMIN_EMAILS={{ admin_emails }}
SESSION_FILE_DIR=/var/lib/ajs-admin/sessions
RATELIMIT_STORAGE_URI=memory://

# Web container host binding
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8086