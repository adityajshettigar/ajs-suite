APP_ENV=production
APP_BASE_URL={{ app_base_url }}
DOMAIN={{ domain }}
SECRET_KEY={{ secret_key }}
GOOGLE_CLIENT_ID={{ google_client_id | default('placeholder.apps.googleusercontent.com') }}
GOOGLE_CLIENT_SECRET={{ google_client_secret | default('placeholder') }}
ADMIN_EMAILS={{ admin_emails }}
SESSION_FILE_DIR=/var/lib/ajs-admin/sessions
RATELIMIT_STORAGE_URI=memory://
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=80
CLOUDFLARE_TUNNEL_TOKEN={{ cloudflare_tunnel_token | default('placeholder') }}
GRAFANA_ADMIN_PASSWORD={{ grafana_admin_password | default('placeholder') }}
KIBANA_PASSWORD={{ kibana_password | default('placeholder') }}
JIRA_BASE_URL={{ jira_base_url | default('https://placeholder.atlassian.net') }}
JIRA_EMAIL={{ jira_email | default('placeholder@example.com') }}
JIRA_API_TOKEN={{ jira_api_token | default('placeholder') }}
JIRA_PROJECT_KEY={{ jira_project_key | default('AJS') }}
JIRA_WEBHOOK_SECRET={{ jira_webhook_secret | default('placeholder') }}
