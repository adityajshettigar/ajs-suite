[Unit]
Description=AJS Suite Admin Authentication Service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/ajs-suite
EnvironmentFile=/etc/ajs-suite/admin.env
ExecStart=/opt/ajs-suite/venv/bin/gunicorn --workers 1 --threads 4 --bind 127.0.0.1:8001 --timeout 30 app:app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ajs-admin
UMask=0077

[Install]
WantedBy=multi-user.target
