[TEMPLATE]
APP_ENV=production
# Use "development" for local testing with http://127.0.0.1:8001
# Use "production" for HTTPS-deployed instances.

# Base URL — must be your canonical domain in production,
# or http://<public-ip> for Phase 1 portfolio-only testing.
# Google OAuth requires HTTPS, so this will be updated in Phase 2.
APP_BASE_URL=http://YOUR-PUBLIC-IP-OR-DOMAIN

# Secret key — must be at least 32 random characters.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# Google OAuth 2.0 / OpenID Connect credentials
# Create these in Google Cloud Console -> APIs & Services -> Credentials
#   -> Create Credentials -> OAuth client ID -> Web application
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET

# Admin email allowlist — comma-separated list of Google account emails
# that are allowed into the /admin/ area.
# These must be verified Google accounts (have @ in the domain).
# Example: ADMIN_EMAILS=admin@example.com,dev@example.com
ADMIN_EMAILS=you@example.com

# Session storage directory
SESSION_FILE_DIR=/var/lib/ajs-admin/sessions

# Rate limiting storage — "memory://" is fine for single-instance deployments.
# For multi-instance, use a shared store like Redis: "redis://localhost:6379"
RATELIMIT_STORAGE_URI=memory://

# Web container host binding
# Bind web (nginx) to 127.0.0.1 so only local traffic reaches it from admin container
WEB_BIND_ADDRESS=127.0.0.1
# Port 80 in Phase 1 (maps to nginx listen 80).
# Port may be updated in Phase 2 for cloudflared or custom setups.
WEB_PORT=80# Cloudflare Tunnel (Phase 2+ HTTPS)
# Set CLOUDFLARE_TUNNEL_TOKEN in .env (or vault) after creating a
# named tunnel in Cloudflare Zero Trust dashboard.
#
# 1. Create a tunnel: cloudflow tunnel create ajs-suite
# 2. Run: cloudflared tunnel --no-autoupdate run -t <token>
# 3. Add public hostname: ajs-suite.YOUR-DOMAIN -> http://web:80
#
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_WITH_TUNNEL_TOKEN

# Base URL — must match the Cloudflare Tunnel public hostname.
# Google OAuth redirect URI will use this URL.
APP_BASE_URL=https://ajs-suite.YOUR-DOMAIN

# Google OAuth 2.0 / OpenID Connect credentials
# Create these in Google Cloud Console -> APIs & Services -> Credentials
#   -> Create Credentials -> OAuth client ID -> Web application
#
# Authorized redirect URI: https://ajs-suite.YOUR-DOMAIN/admin/auth/callback
# Authorized JS origin: https://ajs-suite.YOUR-DOMAIN
#
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET

# Admin email allowlist — comma-separated list of Google account emails
# that are allowed into the /admin/ area.
# These must be verified Google accounts (have @ in the domain).
# Example: ADMIN_EMAILS=admin@example.com,dev@example.com
ADMIN_EMAILS=you@example.com

# Grafana admin password (for first login)
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Kibana basic auth password
KIBANA_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Jira integration (Phase 5+)
JIRA_BASE_URL=https://YOUR-ORG.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=REPLACE_WITH_JIRA_API_TOKEN
JIRA_PROJECT_KEY=AJS
JIRA_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SECRET

# Note: In Phase 1, port 8086 is NOT exposed to the host.
# Named volume admin_sessions is used internally by the admin container.
# In Phase 2+, port 8086 may be used for cloudflared tunnel.
